; Nura Care Institute SMTP settings.
; Copy this file to php/smtp.key on the server and fill in real values.
; php/smtp.key is blocked from the web (.htaccess) and never committed.
; If php/smtp.key is missing or blank, the site sends with PHP mail() instead.

; ---- Free option A: Gmail app password (recommended, ~500 emails/day) ----
; 1. Turn on 2-Step Verification at https://myaccount.google.com/security
; 2. Create an app password at https://myaccount.google.com/apppasswords
;    (pick "Mail"); Google shows 16 letters. Paste them below; spaces are fine.
host = "smtp.gmail.com"
port = 465
secure = "ssl"
user = "charliezservices@gmail.com"
pass = "your-16-letter-app-password"
from_email = "charliezservices@gmail.com"
from_name = "Nura Care Institute"

; ---- Free option B: your Hostinger mailbox (best sender match) ----
; host = "smtp.hostinger.com"
; port = 465
; secure = "ssl"
; user = "education@nuracareinstitute.com"
; pass = "your-mailbox-password"
; from_email = "education@nuracareinstitute.com"
; from_name = "Nura Care Institute"

; ---- STARTTLS example (port 587): set secure = "tls" ----
